<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ttslive-a" Width="960" Height="118"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="Manual">
  <Border x:Name="Bg" Background="#F4F9FC" BorderBrush="#28698A30" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition x:Name="AxisRowDef" Height="24"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="AvatarCol" Width="86"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="196"/>
        </Grid.ColumnDefinitions>

        <Ellipse x:Name="Avatar" Grid.Column="0" Width="54" Height="54"
                 VerticalAlignment="Center" HorizontalAlignment="Left" Margin="24,0,0,0"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
          <StackPanel x:Name="NameRowA" Orientation="Horizontal">
            <TextBlock Text="小伊 · EVE" FontSize="13" FontWeight="SemiBold" Foreground="#0D4F68"/>
            <Border Background="#176b9114" BorderBrush="#28698A2E" BorderThickness="1"
                    Padding="6,1" Margin="8,1,0,0">
              <TextBlock x:Name="TagText" Text="台词" FontSize="10" Foreground="#23799D"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="Caption" Text="字幕在这里。"
                     FontSize="21" Foreground="#203849" TextWrapping="Wrap"
                     LineHeight="28" MaxHeight="170" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,26,0">
          <StackPanel x:Name="LiveBox" Orientation="Horizontal" HorizontalAlignment="Right">
            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#C2263F" VerticalAlignment="Center"/>
            <TextBlock Text="LIVE" FontSize="10" Foreground="#C2263F" Margin="6,0,0,0"/>
          </StackPanel>
        </StackPanel>

        <!-- idle strip: [上一句] 最后一句 .... 已收起 · 静默 3.0s  02 / 05 -->
        <Grid x:Name="IdleRow" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center"
              Margin="0,0,26,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="IdleTag" Grid.Column="0" Text="上一句" FontSize="11"
                     Foreground="#8FA8B6" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="IdleText" Grid.Column="1" Text="" FontSize="13"
                     Foreground="#476173" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock x:Name="IdleHint" Text="已收起 · 静默 3.0s" FontSize="10"
                       Foreground="#8FA8B6" VerticalAlignment="Center"/>
            <TextBlock x:Name="IdleCounter" Text="01 / 01" FontSize="10"
                       Foreground="#8FA8B6" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,4,8,0">
          <Button x:Name="BtnMin" Content="—" Width="24" Height="18" FontSize="12"
                  Foreground="#718998" Background="Transparent" BorderThickness="0"
                  Padding="0" Cursor="Hand" ToolTip="最小化到托盘"/>
          <Button x:Name="BtnClose" Content="&#x2715;" Width="24" Height="18" FontSize="10"
                  Foreground="#718998" Background="Transparent" BorderThickness="0"
                  Padding="0" Cursor="Hand" Margin="2,0,0,0" ToolTip="关闭字幕窗"/>
        </StackPanel>
      </Grid>

      <!-- sentence axis: waveform | tick axis | time / speed / counter -->
      <Grid x:Name="AxisRow" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="86"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="Wave" Grid.Column="0" Orientation="Horizontal"
                    VerticalAlignment="Center" HorizontalAlignment="Left" Margin="24,0,0,0"/>

        <Canvas x:Name="Axis" Grid.Column="1" Height="24" Margin="0,0,16,0"
                VerticalAlignment="Center" ClipToBounds="True"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
          <TextBlock x:Name="TimeText" Text="00:00.0 / 00:00.0" FontSize="11"
                     Foreground="#718998" VerticalAlignment="Center"/>
          <Border Background="#176b9110" BorderBrush="#28698A26" BorderThickness="1"
                  Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="SpeedText" Text="1.12x" FontSize="10" Foreground="#23799D"/>
          </Border>
          <TextBlock x:Name="Counter" Text="01 / 01" FontSize="11" Foreground="#718998"
                     Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <Thumb x:Name="Grip" Grid.RowSpan="2" Width="18" Height="18" HorizontalAlignment="Right"
             VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
              <Path Data="M18,11 L18,18 L11,18" Stroke="#176B91" StrokeThickness="1.4"/>
            </Grid>
          </ControlTemplate>
        </Thumb.Template>
        <Thumb.Style>
          <Style TargetType="Thumb">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Thumb.Style>
      </Thumb>
    </Grid>
  </Border>
</Window>
