<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F7FBFD" BorderThickness="0" Padding="14,8,16,8">
  <Border.Resources>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1A176B91"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2E176B91"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="#556C7F"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
  </Border.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- 皮肤 -->
    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <Button x:Name="BtnSkinA" Style="{StaticResource IconBtn}" ToolTip="通栏条幅">
        <StackPanel>
          <Canvas Width="24" Height="20" HorizontalAlignment="Center">
            <Path Data="M2,4 H22 M2,9 H22 M2,14 H14" Stroke="#0D4F68" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas>
          <TextBlock Text="条幅" Style="{StaticResource IconText}"/>
        </StackPanel>
      </Button>
      <Button x:Name="BtnSkinB" Style="{StaticResource IconBtn}" ToolTip="悬浮卡">
        <StackPanel>
          <Canvas Width="24" Height="20" HorizontalAlignment="Center">
            <Rectangle Canvas.Left="3" Canvas.Top="3" Width="18" Height="14"
                       Stroke="#0D4F68" StrokeThickness="1.7"/>
            <Rectangle Canvas.Left="6" Canvas.Top="12" Width="9" Height="2" Fill="#0D4F68"/>
          </Canvas>
          <TextBlock Text="卡片" Style="{StaticResource IconText}"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <Border Grid.Column="1" Width="1" Background="#2228698A" Margin="4,6,8,6"/>

    <!-- 历史 / 居中 -->
    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button x:Name="BtnHistory" Style="{StaticResource IconBtn}" ToolTip="历史记录">
        <StackPanel>
          <Canvas Width="24" Height="20" HorizontalAlignment="Center">
            <Ellipse Canvas.Left="4" Canvas.Top="2" Width="16" Height="16"
                     Stroke="#0D4F68" StrokeThickness="1.7"/>
            <Path Data="M12,5.5 V10.5 L15.5,12.5" Stroke="#0D4F68" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas>
          <TextBlock Text="历史" Style="{StaticResource IconText}"/>
        </StackPanel>
      </Button>
      <Button x:Name="BtnCenter" Style="{StaticResource IconBtn}" ToolTip="回到屏幕底部居中">
        <StackPanel>
          <Canvas Width="24" Height="20" HorizontalAlignment="Center">
            <Path Data="M12,2 V18 M3,10 H21" Stroke="#0D4F68" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Rectangle Canvas.Left="9.5" Canvas.Top="7.5" Width="5" Height="5" Fill="#176B91"/>
          </Canvas>
          <TextBlock Text="居中" Style="{StaticResource IconText}"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <Border Grid.Column="3" Width="1" Background="#2228698A" Margin="6,6,10,6"/>

    <!-- 透明度 -->
    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="背景透明度" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#476173"/>
        <TextBlock x:Name="TxtOpacity" Text="92%" FontFamily="Microsoft YaHei UI" FontSize="11"
                   Foreground="#176B91" Margin="8,0,0,0"/>
      </StackPanel>
      <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" Value="92" Height="22" Margin="0,2,0,0">
        <Slider.Template>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="3" Background="#2E28698A" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Height="3" BorderThickness="0"
                                Focusable="False" Background="#176B91"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Height="3" BorderThickness="0"
                                Focusable="False" Background="Transparent"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="8" Height="18">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#176B91" BorderBrush="#FFFFFF" BorderThickness="1"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Slider.Template>
      </Slider>
    </StackPanel>

    <Border Grid.Column="5" Width="1" Background="#2228698A" Margin="0,6,4,6"/>

    <!-- 关闭 -->
    <Button Grid.Column="6" x:Name="BtnExit" Style="{StaticResource IconBtn}" Margin="4,0,0,0" ToolTip="退出字幕窗">
      <StackPanel>
        <Canvas Width="24" Height="20" HorizontalAlignment="Center">
          <Path Data="M8,4 L16,16 M16,4 L8,16" Stroke="#B5701F" StrokeThickness="1.8"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
        <TextBlock Text="退出" Style="{StaticResource IconText}"/>
      </StackPanel>
    </Button>
  </Grid>
</Border>
